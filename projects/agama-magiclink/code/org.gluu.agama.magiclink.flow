Flow org.gluu.agama.magiclink
     Basepath ""
// Create and initialize variable to receive email input
emailObj = {errorMessage: ""}
// Iterate x times max
Repeat 3 times max
     // Retrieve user email address from UI
     uiInput = RRF "main.ftlh" emailObj
     // Assign user email input to a variable
     email = uiInput.email
     // Create an instance of MagicLinkService
     magicLinkService = Call org.gluu.agama.jans.MagicLinkService#getInstance 